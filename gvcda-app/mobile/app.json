{
  "expo": {
    "name": "GVCDA",
    "slug": "gvcda-app",
    "scheme": "gvcda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gvcdaservicehub.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GVCDA uses your location to log field visits."
      }
    },
    "android": {
      "package": "com.gvcdaservicehub.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GVCDA uses your location to log field visits."
        }
      ]
    ]
  }
}
