# Copy this file to .env and fill in real values before deploying.
# Nothing here is required for local dev — every integration below has a safe
# mock/demo fallback when its variables are unset. See ../GO_LIVE.md.

NODE_ENV=development
PORT=4000

# Where the SQLite file lives. Leave unset for local dev. In production on
# Render, point this at your persistent disk's mount path — see render.yaml,
# which already sets this to /var/data/gvcda.db for you.
DB_PATH=

# --- File storage: retailer/product photos ---
# Leave both unset for local dev — falls back to local disk storage under
# backend/uploads/, zero setup needed (see lib/uploads.js). Set both to switch
# to Supabase Storage in production: in your Supabase project, Storage tab,
# create a bucket (default name below, or override with SUPABASE_BUCKET) and
# mark it Public so uploaded photos are viewable without a signed URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gvcda-photos

# Comma-separated list of origins allowed to call this API (your web app's domain,
# and your Expo mobile app's origin if you serve it from somewhere with a fixed one).
# Leave unset in development to allow all origins.
CORS_ORIGIN=https://app.gvcdaservicehub.com

# Long random string — required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- SMS OTP (pick ONE provider) ---
# MSG91 (India, needs DLT template registration — see GO_LIVE.md)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments: direct bank/UPI transfer (no payment gateway account) ---
# The account members pay memberships into, and retailers settle commission into.
# These default to the real GVCDA account already, in lib/bankDetails.js — only
# set these if that account ever changes.
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_NAME=
BANK_UPI_ID=
